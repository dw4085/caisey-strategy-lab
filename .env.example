# Neon pooled connection string (server-only)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Class hub sign-in and activity reports (server-only)
HUB_URL=https://preview.cbs-tech-strategy.com
HUB_JWT_PUBLIC_KEY=base64-of-the-hub-public-key-pem
HUB_COOKIE_NAME=cts_preview_session
HUB_APP_SLUG=caisey-strategy-lab
HUB_APP_KEY=app-key-from-hub-admin
# Optional: only while the hub's deployment sits behind Vercel Authentication
# HUB_PROTECTION_BYPASS=

# Guards the daily sweep (/api/hub/sweep, Vercel Cron)
CRON_SECRET=a-long-random-string
